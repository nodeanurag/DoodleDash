{
  "name": "doodle-dash",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time multiplayer drawing and guessing game",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "build": "npm run build --workspace=@doodle/shared && npm run build --workspace=@doodle/server && npm run build --workspace=@doodle/client",
    "build:shared": "npm run build --workspace=@doodle/shared",
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev --workspace=@doodle/server\" \"npm run dev --workspace=@doodle/client\"",
    "dev:server": "npm run dev --workspace=@doodle/server",
    "dev:client": "npm run dev --workspace=@doodle/client",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
